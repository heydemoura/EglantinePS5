#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D guest_color;
layout(binding = 1, rgba16f) uniform writeonly image2D dlss_color;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(dlss_color)))) {
        return;
    }
    // The guest has already tonemapped this square-root-encoded color for LDR.
    // Below 1x (Settings > Video > Resolution) the scene is smaller than the guest's colour, which a
    // compute pass writes at full size: the nearest guest pixel to this scene pixel's centre.
    const ivec2 source = ivec2((vec2(pixel) + 0.5) * vec2(textureSize(guest_color, 0)) /
                               vec2(imageSize(dlss_color)));
    imageStore(dlss_color, pixel, vec4(texelFetch(guest_color, source, 0).rgb, 1.0));
}
