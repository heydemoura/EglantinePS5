++                                   : before.Read(dest) | (u64{before.Read(dest + 1)} << 32);
++                        machine.Run(lowered.instructions);
++                        REQUIRE((machine.Read(dest) | (u64{machine.Read(dest + 1)} << 32)) ==
++                                expected);
++                        CheckUnchanged(before, machine, dest, 2);
++                    }
++                }
++            }
++        }
++    }
++}
