++            REQUIRE_FALSE(DecodeProgramOverride(truncated, Source));
++        }
++        auto trailing = bytes;
++        trailing.push_back(0);
++        REQUIRE(ProgramOverrideSourceSize(trailing) == 0);
++        REQUIRE_FALSE(DecodeProgramOverride(trailing, Source));
