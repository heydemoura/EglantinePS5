+// Backported from ProsperoEden (GPL-3.0-or-later, its patch 0060): the console's 64-bit fastmem window maps 16 KiB pages, so it can show a guest
+// page only where the guest address and its backing agree modulo 16 KiB. A stack mapped from the
+// game's heap at an address that does not (most of them: MapMemory's two addresses are the game's
+// choice) kept every access to it, and every site that ever touched one, on the page-table path:
+// ~70k window refusals a race in Mario Kart World, all in the stack region. Such a mapping gets
+// pages of its own that agree, copied from the source, which is locked and not mapped for the
+// guest until UnmapMemory copies them back.
+constexpr u64 EdenWindowPage = 0x4000;
+std::mutex eden_moved_mutex;
+std::map<std::pair<const void*, u64>, size_t> eden_moved;  // (table, stack address) -> pages
+
+bool EdenWindowMisaligned(const KPageGroup& pg, KProcessAddress dst) {
+    if (!Eden::Fastmem::Window64Base || Eden::Fastmem::Window64Base() == 0) {
+        return false;
+    }
+    u64 offset = 0;
+    for (const auto& block : pg) {
+        if ((GetInteger(dst) + offset - GetInteger(block.GetAddress())) % EdenWindowPage != 0) {
+            return true;
+        }
+        offset += block.GetSize();
+    }
+    return false;
+}
+
+// Copies `size` bytes between two page groups of the same length, block by block.
+void EdenCopyPages(KernelCore& kernel, const KPageGroup& to, const KPageGroup& from) {
+    auto to_it = to.begin(), from_it = from.begin();
+    u64 to_off = 0, from_off = 0;
+    while (to_it != to.end() && from_it != from.end()) {
+        const u64 bytes = std::min(to_it->GetSize() - to_off, from_it->GetSize() - from_off);
+        std::memcpy(KPageTableBase::GetHeapVirtualPointer(kernel, to_it->GetAddress() + to_off),
+                    KPageTableBase::GetHeapVirtualPointer(kernel, from_it->GetAddress() + from_off), bytes);
+        to_off += bytes;
+        from_off += bytes;
+        if (to_off == to_it->GetSize()) ++to_it, to_off = 0;
+        if (from_off == from_it->GetSize()) ++from_it, from_off = 0;
+    }
+}
