diff --git a/src/video_core/command_write_frontier.h b/src/video_core/command_write_frontier.h
new file mode 100644
index 0000000000..f6cf7f22d3
--- /dev/null
+++ b/src/video_core/command_write_frontier.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include "common/common_types.h"
+
+namespace VideoCommon {
+
+// Producer-owned ring position of the latest entry that could affect command
+// memory. Inert sink appends, engine switches and proven state-only writes may be
+// omitted. A direct 3D state write is NOT inert if it could flush a deferred draw.
+// Uploads, dispatches, draws, unknown methods and callbacks remain hazards.
+class CommandWriteFrontier {
+public:
+    static constexpr bool StateWriteMayExecute(bool state_only, bool deferred_draw_pending) {
+        return !state_only || deferred_draw_pending;
+    }
+
+    void Commit(u64 end, bool may_write) {
+        if (may_write) last_writer = end;
+    }
+    u64 Target() const { return last_writer; }
+    void Reset() { last_writer = 0; }
+
+private:
+    u64 last_writer{};
+};
+
+} // namespace VideoCommon
diff --git a/src/video_core/split_completion.h b/src/video_core/split_completion.h
new file mode 100644
index 0000000000..a2231a3b99
--- /dev/null
+++ b/src/video_core/split_completion.h
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include "common/common_types.h"
+
+namespace VideoCommon {
+
+// One front-side requester and one back-side publisher. The request is only a
+// notification hint; visibility of completed work still uses consumed's
+// release/acquire pair. Never acknowledge work merely because it was requested.
+class SplitCompletion {
+public:
+    void Request(u64 position) {
+        requested.store(position, std::memory_order_relaxed);
+    }
+
+    bool ShouldPublish(u64 completed, u64 last_published) const {
+        const u64 target = requested.load(std::memory_order_relaxed);
+        return completed - last_published >= 4096 ||
+               (last_published < target && completed >= target);
+    }
+
+    // Only after the back thread has stopped.
+    void Reset() {
+        requested.store(0, std::memory_order_relaxed);
+    }
+
+private:
+    alignas(64) std::atomic<u64> requested{};
+};
+
+} // namespace VideoCommon
