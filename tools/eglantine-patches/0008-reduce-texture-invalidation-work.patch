+// Descriptor tables are invalidated below whenever cached views disappear. Their
+// next read must replace the cached ID even when the guest descriptor is unchanged.
+// Keep optional poisoning for diagnostics without walking every historical TIC
+// entry on every streamed texture deletion in native PS5 builds.
+inline bool PoisonInvalidatedViewIds() {
+#if defined(__PROSPERO__)
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_TEXTURE_CACHE_POISON_IDS");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+#else
+    return true;
+#endif
+}
