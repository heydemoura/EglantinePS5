+// What DecodeBlockInfo makes of each 11-bit block mode, so IsOpaque reads a block's header with
+// one load instead of bit by bit: it scans every block of each new ASTC texture on the GPU
+// thread (up to 64 MiB), and bit by bit that was ~45 % of the GPU thread's back in Mario Kart
+// World's long race frames in ProsperoEden. Built with bit 11 set: a void-extent block's second
+// "must be one" bit is checked per block.
+namespace {
+struct BlockModeInfo {
+    u8 kind; // 0 weights, 1 error, 2 void extent LDR, 3 void extent HDR
+    bool dual_plane;
+    u16 weight_bits;
+};
+
+const std::array<BlockModeInfo, 2048>& BlockModes() {
+    static const auto table = [] {
+        std::array<BlockModeInfo, 2048> modes{};
+        for (u32 mode = 0; mode < modes.size(); ++mode) {
+            const std::array<u8, 2> bytes{static_cast<u8>(mode), static_cast<u8>((mode >> 8) | 0x08)};
+            InputBitStream strm(bytes);
+            const TexelWeightParams params = DecodeBlockInfo(strm);
+            auto& info = modes[mode];
+            info.kind = params.m_bError ? 1 : params.m_bVoidExtentLDR ? 2 : params.m_bVoidExtentHDR ? 3 : 0;
+            info.dual_plane = params.m_bDualPlane;
+            info.weight_bits = info.kind == 0 ? static_cast<u16>(params.GetPackedBitSize()) : 0;
+        }
+        return modes;
+    }();
+    return table;
+}
+} // namespace
