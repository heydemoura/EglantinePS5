+/// EDEN_NX2_FAST_DRAW=0 turns fast draws off. Read at the first use, not in a static initializer:
+/// the PS5 app sets its environment from env.txt in main.
+[[nodiscard]] inline std::atomic<bool>& EnabledFlag() {
+    static std::atomic<bool> enabled{[] {
+        const char* const value = std::getenv("EDEN_NX2_FAST_DRAW");
+        return value == nullptr || value[0] != '0';
+    }()};
+    return enabled;
+}
 
 /// Any thread: whether fast draws run. The rasterizer latches it per draw (on the thread that
 /// draws) and starts with a full resolve when it turns on.
 [[nodiscard]] inline bool Enabled() {
-    return g_enabled.load(std::memory_order_relaxed);
+    return EnabledFlag().load(std::memory_order_relaxed);
 }
 
