+void Maxwell3D::DumpIndexState() const {
+    static std::atomic_flag reported = ATOMIC_FLAG_INIT;
+    if (reported.test_and_set(std::memory_order_relaxed)) return;
+    const auto& raw = regs.index_buffer;
+    const auto& draw = draw_manager.draw_state;
+    const auto& copy = draw.index_buffer;
+    std::fprintf(stderr,
+        "MKW_INDEX_ORIGIN regs_start=%llx regs_end=%llx regs_format=%u regs_first=%08x regs_count=%08x "
+        "draw_start=%llx draw_end=%llx draw_format=%u draw_first=%08x draw_count=%08x "
+        "mode=%u indexed=%u instances=%u base_index=%u base_instance=%u writes=%llu\n",
+        static_cast<unsigned long long>(raw.StartAddress()),
+        static_cast<unsigned long long>(raw.EndAddress()), unsigned(raw.format), raw.first, raw.count,
+        static_cast<unsigned long long>(copy.StartAddress()),
+        static_cast<unsigned long long>(copy.EndAddress()), unsigned(copy.format), copy.first, copy.count,
+        unsigned(draw.draw_mode), unsigned(draw.draw_indexed), draw.instance_count,
+        draw.base_index, draw.base_instance, static_cast<unsigned long long>(recent_write_index));
+    const auto& shadow = shadow_state.index_buffer;
+    std::fprintf(stderr,
+        "MKW_INDEX_SHADOW control=%u start=%llx end=%llx format=%u first=%08x count=%08x\n",
+        unsigned(shadow_state.shadow_ram_control),
+        static_cast<unsigned long long>(shadow.StartAddress()),
+        static_cast<unsigned long long>(shadow.EndAddress()),
+        unsigned(shadow.format),shadow.first,shadow.count);
+    const size_t begin = recent_write_index > recent_writes.size()
+                             ? recent_write_index - recent_writes.size() : 0;
+    for (size_t index = begin; index < recent_write_index; ++index) {
+        const auto& write = recent_writes[index % recent_writes.size()];
+        std::fprintf(stderr, "MKW_INDEX_RECENT sequence=%llu method=%04x raw=%08x amount=%u pending=%u\n",
+            static_cast<unsigned long long>(index),write.method,write.argument,write.amount,write.pending);
+    }
+    std::fflush(stderr);
+}
