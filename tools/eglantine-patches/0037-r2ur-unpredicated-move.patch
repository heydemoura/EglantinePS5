diff --git a/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h b/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
index 51a40e3780..448f337b2b 100644
--- a/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
+++ b/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
@@ -781,8 +781,15 @@ case 0x311: { // F2I.FTZ.U64.TRUNC, per nvdisasm: Maxwell's F2I gives 32 bits, s
             emit(0x5c30000000070000ULL | 250 | (u64{250} << 20));
             emit(0xef10000000070000ULL | 251 | (u64{insn.Bits(24, 8)} << 8) |
                  (u64{250} << 20) | (u64{1} << 29) | (u64{31} << 34) | (u64{7} << 48));
-            emit(0x5ca0000000070000ULL | target | (u64{251} << 8) |
-                 (u64{target} << 20) | (u64{6} << 39));
+            if (native_predicate == 7) {
+                // Every lane executing it is in the ballot, so no lane-less fallback can be taken.
+                // Leaving the old value selectable would make it a source of the result for the
+                // texture and global memory tracking (a handle traced to the uniform's last load).
+                emit(0x5c98000000070000ULL | target | (u64{15} << 39) | (u64{251} << 20));
+            } else {
+                emit(0x5ca0000000070000ULL | target | (u64{251} << 8) |
+                     (u64{target} << 20) | (u64{6} << 39));
+            }
             restore_predicate();
             break;
         }
diff --git a/src/tests/video_core/ampere_pokopia_compute.cpp b/src/tests/video_core/ampere_pokopia_compute.cpp
index e910d21e0f..07e47f1cdf 100644
--- a/src/tests/video_core/ampere_pokopia_compute.cpp
+++ b/src/tests/video_core/ampere_pokopia_compute.cpp
@@ -191,4 +191,25 @@ TEST_CASE("Ampere HFMA2 H0_NH1 swaps the halves of b and negates the new low hal
     REQUIRE(lowered.instructions[1] == 0x044000080007fbfbULL);
     REQUIRE(lowered.instructions[2] == 0x5d0009000fb70c0cULL);
 }
+
+TEST_CASE("Ampere unpredicated R2UR writes the broadcast value directly", "[video_core][ampere]") {
+    // R2UR UR5, R6 from Pokemon Pokopia's pixel shaders (op 3c2 060573c2 00000000 000e0000
+    // 001e2600). UR5 lives in R221. Unpredicated, every executing lane is in the ballot, so the
+    // keep-the-old-value SEL was unreachable; it made the old value a second source for the
+    // texture handle and global memory tracking.
+    const Instruction move{{0x060573c2, 0, 0x000e0000, 0x001e2600}};
+    const auto lowered = LowerToMaxwell(std::array{move, Exit});
+    INFO(lowered.error);
+    REQUIRE(static_cast<bool>(lowered));
+    REQUIRE(Contains(lowered.instructions, 0x5c9807800fb700ddULL)); // MOV R221, R251
+    REQUIRE(std::none_of(lowered.instructions.begin(), lowered.instructions.end(),
+                         [](u64 word) { return (word >> 48) == 0x5ca0; }));
+    // Under a predicate a lane may be outside the ballot: the old value stays selectable.
+    auto guarded = move;
+    guarded.words[0] = (guarded.words[0] & ~0xf000U) | (1U << 12);
+    const auto selected = LowerToMaxwell(std::array{guarded, Exit});
+    INFO(selected.error);
+    REQUIRE(static_cast<bool>(selected));
+    REQUIRE(Contains(selected.instructions, 0x5ca003000dd7fbddULL)); // SEL R221, R251, R221, P6
+}
 } // namespace
