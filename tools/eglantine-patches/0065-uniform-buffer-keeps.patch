+std::span<u8> BufferCacheRuntime::BindStreamedUniform(size_t stage, u32 index, DAddr device_addr,
+                                                      u32 size) {
+    const StagingBufferRef ref = staging_pool.Request(size, MemoryUsage::Upload);
+    guest_descriptor_queue.AddBuffer(ref.buffer, ref.device_address,
+                                     static_cast<u32>(ref.offset), size);
+    NoteStreamedUniform(stage, index, ref, device_addr, size);
+    return ref.mapped_span;
+}
+
+void BufferCacheRuntime::NoteStreamedUniform(size_t stage, u32 index, const StagingBufferRef& ref,
+                                             DAddr device_addr, u32 size) {
+    if (stage < last_uniforms.size() && index < last_uniforms[stage].size()) {
+        last_uniforms[stage][index] = LastUniform{
+            .ref = ref,
+            .device_addr = device_addr,
+            .tick = scheduler.CurrentTick(),
+            .size = size,
+        };
+    }
+}
+
+const BufferCacheRuntime::LastUniform* BufferCacheRuntime::FindLastUniform(size_t stage, u32 index,
+                                                                           DAddr device_addr,
+                                                                           u32 size) {
+    if (size == 0 || stage >= last_uniforms.size() || index >= last_uniforms[stage].size()) {
+        return nullptr;
+    }
+    const LastUniform& last = last_uniforms[stage][index];
+    // A stream allocation stays untouched until the GPU ran the command buffer it was made in.
+    if (last.size != size || last.device_addr != device_addr ||
+        last.tick != scheduler.CurrentTick()) {
+        return nullptr;
+    }
+    return &last;
+}
+
+bool BufferCacheRuntime::RebindKeptUniform(size_t stage, u32 index, DAddr device_addr, u32 size) {
+    const LastUniform* const last = FindLastUniform(stage, index, device_addr, size);
+    if (last == nullptr) {
+        return false;
+    }
+    guest_descriptor_queue.AddBuffer(last->ref.buffer, last->ref.device_address,
+                                     static_cast<u32>(last->ref.offset), size);
+    return true;
+}
+
+std::optional<bool> BufferCacheRuntime::KeptUniformHolds(
+    Tegra::MaxwellDeviceMemoryManager& device_memory, size_t stage, u32 index, DAddr device_addr,
+    u32 size) {
+    const LastUniform* const last = FindLastUniform(stage, index, device_addr, size);
+    if (last == nullptr) {
+        return std::nullopt;
+    }
+    static thread_local std::vector<u8> guest;
+    guest.resize(size);
+    device_memory.ReadBlockUnsafe(device_addr, guest.data(), size);
+    return std::memcmp(last->ref.mapped_span.data(), guest.data(), size) == 0;
+}
