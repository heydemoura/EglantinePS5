+template <class P>
+bool BufferCache<P>::UniformRangeKept(size_t stage, u32 index, DAddr device_addr,
+                                      u32 size) const noexcept {
+    const UniformKeep& keep = uniform_keep;
+    if (((keep.candidates[stage] >> index) & 1) == 0) {
+        return false;
+    }
+    const auto overlaps = [&](const std::pair<DAddr, DAddr>& write) {
+        return write.first < device_addr + size && device_addr < write.second;
+    };
+    return !keep.memory_writes_lost && std::ranges::none_of(keep.writes, overlaps) &&
+           std::ranges::none_of(keep.memory_writes, overlaps);
+}
+
+template <class P>
+void BufferCache<P>::ReportUniformKeeps() {
+    UniformKeep& keep = uniform_keep;
+    if (!keep.verify && !Nx2Profile::Enabled()) {
+        return;
+    }
+    const u64 now = Nx2Profile::Now();
+    if (now < keep.next_report) {
+        return;
+    }
+    if (keep.next_report != 0) {
+        LOG_INFO(HW_GPU,
+                 "Uniform keeps in 10 s: {} kept, {} streamed, {} verified, {} verify mismatches "
+                 "({} draws){}",
+                 keep.kept, keep.streamed_binds, keep.verified, keep.mismatches, keep.draws,
+                 keep.enabled ? "" : " (off: EDEN_NX2_UBO_KEEP=0)");
+    }
+    keep.kept = keep.streamed_binds = keep.verified = keep.mismatches = keep.draws = 0;
+    keep.next_report = now + 10'000'000'000ULL;
+}
