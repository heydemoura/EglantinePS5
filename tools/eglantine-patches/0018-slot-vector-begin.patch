SlotVector::begin() took std::distance with its arguments swapped: when the first non-empty word of the
storage bitset is not the first word, the index went negative and iteration yielded nothing. Every
range-for over a slot vector whose first 64 slots are free skipped all its entries, among them
BufferCacheRuntime::TickFrame, which resets buffer usage tracking every frame.
(ProsperoEden patches/eglantine/eglantine-a42b4d4-ps5.d/0061-slot-vector-begin.diff)

diff --git a/src/common/slot_vector.h b/src/common/slot_vector.h
index f6da7a5..542b33a 100644
--- a/src/common/slot_vector.h
+++ b/src/common/slot_vector.h
@@ -139,7 +139,7 @@ public:
         if (it == stored_bitset.end()) {
             return end();
         }
-        const u32 word_index = static_cast<u32>(std::distance(it, stored_bitset.begin()));
+        const u32 word_index = static_cast<u32>(std::distance(stored_bitset.begin(), it));
         const SlotId first_id{word_index * 64 + static_cast<u32>(std::countr_zero(*it))};
         return Iterator(this, first_id);
     }
