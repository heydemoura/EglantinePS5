+    VkMemoryPropertyFlags properties{};
+    vmaGetAllocationMemoryProperties(allocator, allocation, &properties);
+    if (!(properties & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)) return {};
+    VmaAllocationInfo info{};
