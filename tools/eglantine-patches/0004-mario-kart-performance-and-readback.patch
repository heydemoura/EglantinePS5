+extern "C" bool eden_download_copy_batch_enabled() __attribute__((weak));
+extern "C" void eden_download_copy_batch_result(u64 regions, u64 commands) __attribute__((weak));
+
+// Consecutive regions from one source share a command. Keep the complete region
+// order, including A/B/A source changes; destination offsets already name disjoint
+// staging ranges. The callback must copy the bounded span before returning.
+template <size_t Capacity = 32, class Downloads, class Function>
+void ForEachDownloadCopyBatch(const Downloads& downloads, Function&& function) {
+    static_assert(Capacity > 0);
+    if (downloads.empty()) return;
+    using Copy = typename Downloads::value_type::first_type;
+    std::array<Copy, Capacity> batch;
+    auto source = downloads.front().second;
+    size_t count = 0;
+    const auto flush = [&] {
+        function(source, std::span<const Copy>{batch.data(), count});
+        count = 0;
+    };
+    for (const auto& [copy, id] : downloads) {
+        if (count && (source != id || count == Capacity)) flush();
+        source = id;
+        batch[count++] = copy;
+    }
+    if (count) flush();
+}
