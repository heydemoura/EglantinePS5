+    if (vmaMapMemory(allocator, allocation, &pointer) != VK_SUCCESS) return {};
+    if (!pointer) { vmaUnmapMemory(allocator, allocation); return {}; }
+    mapped = {static_cast<u8*>(pointer), size};
+    readback_mapping = true;
+    return mapped;
