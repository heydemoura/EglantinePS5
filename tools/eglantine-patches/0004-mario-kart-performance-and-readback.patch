+
+bool BufferCacheRuntime::NeedsReadbackPromotion(const Buffer& buffer) {
+    if (buffer.IsSparseCompatible() || buffer.readback_promotion_failed ||
+        !buffer.readback_mapping.empty() || buffer.readback_requests < 2 ||
+        !ReadbackTrackingEnabled()) return false;
+    return mapped_readback_policy.Prefer(buffer.CpuAddr(), buffer.SizeBytes());
+}
+
+std::span<const u8> BufferCacheRuntime::TryMappedReadback(
+    const Buffer& buffer, std::span<const VideoCommon::BufferCopy> copies) {
+    const auto reject = [](unsigned reason) -> std::span<const u8> {
+        if (eden_mapped_readback_reject) eden_mapped_readback_reject(reason);
+        return {};
+    };
+    if (!MappedReadbackMode()) return {};
+    if (buffer.IsSparseCompatible() || buffer.readback_mapping.empty() ||
+        !buffer.readback_writes || copies.empty()) return reject(0);
+    if (buffer.readback_writes->external_writer) return reject(1);
+    // Bounded snapshots let us recheck range identities after a producer wait.
+    // The cache owner holds the recording state; asynchronous mapping changes
+    // still invalidate the shared epoch and must reject this certificate.
+    std::array<VideoCommon::ReadbackRangeTracker::Ticket, 32> tickets;
+    if (copies.size() > tickets.size()) return reject(2);
+    u64 producer = 0;
+    size_t index = 0;
+    for (const auto& copy : copies) {
+        const auto ticket = buffer.readback_writes->Lookup(copy.src_offset, copy.size);
+        if (!ticket) return reject(2);
+        tickets[index++] = *ticket;
+        producer = (std::max)(producer, ticket->producer);
+    }
+    // A future tick cannot have been recorded by this scheduler lifetime.
+    if (producer > scheduler.CurrentTick()) return reject(2);
+    if (!scheduler.IsFree(producer)) {
+        if (!eden_readback_producer_wait_enabled || !eden_readback_producer_wait_enabled())
+            return reject(3);
+        if (eden_readback_producer_wait_result)
+            eden_readback_producer_wait_result(producer, scheduler.CurrentTick());
+        // Wait submits the current tick only when it contains this producer.
+        // Already-submitted producers do not flush unrelated later commands.
+        scheduler.Wait(producer);
+        if (!scheduler.IsFree(producer)) return reject(3);
+    }
+    if (buffer.readback_writes->external_writer) return reject(1);
+    index = 0;
+    for (const auto& copy : copies) {
+        const auto current = buffer.readback_writes->Lookup(copy.src_offset, copy.size);
+        const auto& saved = tickets[index++];
+        if (!current || current->allocation != saved.allocation || current->epoch != saved.epoch ||
+            current->version != saved.version || current->producer != saved.producer)
+            return reject(2);
+    }
+    // The GPU/cache owner prevents recording a newer writer while copying.
+    // Mapped allocations enable HOST_READ visibility before any producer is recorded.
+    return buffer.readback_mapping;
+}
+
+void BufferCacheRuntime::ValidateMappedReadback(std::span<const u8> expected,
+                                               std::span<const u8> actual) {
+    const bool mismatch = expected.size() != actual.size() ||
+                          !std::equal(expected.begin(), expected.end(), actual.begin());
+    mapped_readback_failed |= mismatch;
+    if (eden_mapped_readback_result) eden_mapped_readback_result(0, expected.size(), mismatch);
+}
