diff --git a/src/common/host_command_completion.h b/src/common/host_command_completion.h
new file mode 100644
index 0000000000..6c7545012c
--- /dev/null
+++ b/src/common/host_command_completion.h
@@ -0,0 +1,54 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <condition_variable>
+#include <memory>
+#include <mutex>
+#include <stop_token>
+
+namespace Common {
+
+// One synchronous command at a time per submitting host thread. A queued command keeps
+// its own reference through Signal(), even if Wait() returns and the caller exits.
+class HostCommandCompletion final {
+public:
+    static std::shared_ptr<HostCommandCompletion> ForCurrentThread() {
+        thread_local auto completion = std::make_shared<HostCommandCompletion>();
+        if (!completion->Reusable()) completion = std::make_shared<HostCommandCompletion>();
+        completion->Reset();
+        return completion;
+    }
+
+    void Wait() {
+        std::unique_lock lock{mutex};
+        ready.wait(lock, [this] { return done; });
+    }
+    bool Wait(std::stop_token stop) {
+        std::unique_lock lock{mutex};
+        if (ready.wait(lock, stop, [this] { return done; })) return true;
+        reusable = false; // A late callback must never complete a later request.
+        return false;
+    }
+    void Signal() {
+        std::lock_guard lock{mutex};
+        done = true;
+        ready.notify_one();
+    }
+
+private:
+    bool Reusable() {
+        std::lock_guard lock{mutex};
+        return reusable;
+    }
+    void Reset() {
+        std::lock_guard lock{mutex};
+        done = false;
+    }
+    std::mutex mutex;
+    std::condition_variable_any ready;
+    bool done{};
+    bool reusable{true};
+};
+
+} // namespace Common
diff --git a/src/common/host_command_queue.h b/src/common/host_command_queue.h
new file mode 100644
index 0000000000..69e9c904e9
--- /dev/null
+++ b/src/common/host_command_queue.h
@@ -0,0 +1,55 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eglantine Contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <condition_variable>
+#include <deque>
+#include <mutex>
+#include <utility>
+
+#include "common/polyfill_thread.h"
+
+namespace Common {
+
+// Publishing host work must not wait for the consumer to execute earlier work.
+// Producers can hold a memory-registry lock that the GPU consumer needs before
+// it can finish its current command. A bounded queue creates a lock cycle there.
+template <typename T>
+class HostCommandQueue {
+public:
+    template <typename... Args>
+    void Emplace(Args&&... args) {
+        {
+            std::scoped_lock lock{mutex};
+            entries.emplace_back(std::forward<Args>(args)...);
+        }
+        available.notify_one();
+    }
+
+    bool TryPop(T& out) {
+        std::scoped_lock lock{mutex};
+        if (entries.empty()) {
+            return false;
+        }
+        out = std::move(entries.front());
+        entries.pop_front();
+        return true;
+    }
+
+    void PopWait(T& out, std::stop_token stop) {
+        std::unique_lock lock{mutex};
+        if (!available.wait(lock, stop, [this] { return !entries.empty(); })) {
+            return;
+        }
+        out = std::move(entries.front());
+        entries.pop_front();
+    }
+
+private:
+    std::mutex mutex;
+    std::condition_variable_any available;
+    std::deque<T> entries;
+};
+
+} // namespace Common
