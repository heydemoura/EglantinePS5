new file mode 100644
index 0000000000..8965b9dd3e
--- /dev/null
+++ b/src/video_core/submitted_commands.h
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <new>
+#include <optional>
+#include <span>
+#include <vector>
+
+extern "C" bool eden_command_snapshot_enabled() __attribute__((weak));
+extern "C" void eden_command_snapshot_captured(std::uint64_t) __attribute__((weak));
+extern "C" void eden_command_snapshot_fetch(unsigned, std::uint64_t) __attribute__((weak));
+
+namespace VideoCommon {
+inline bool CommandSnapshotsEnabled() {
+    return eden_command_snapshot_enabled && eden_command_snapshot_enabled();
+}
+
+// Selection follows Zortos cce6d44af2, 6612817cb4 and fae3bc64. A flush must
+// disqualify a stale snapshot even after it cleared the cache's dirty state.
+constexpr bool CanUseSubmittedCommands(bool resumed, bool has_snapshot, bool gpu_written,
+                                       bool safe_read_dirty) {
+    return !resumed && has_snapshot && !gpu_written && !safe_read_dirty;
+}
+
+template <typename Word>
+class SubmittedCommands {
+public:
+    SubmittedCommands() = default;
+    SubmittedCommands(const SubmittedCommands&) = delete;
+    SubmittedCommands& operator=(const SubmittedCommands&) = delete;
+    static constexpr std::size_t MaxSnapshotBytes = 16 * 1024 * 1024;
+    static constexpr std::size_t BudgetBytes = 64 * 1024 * 1024;
+    static constexpr std::size_t MaxEntries = 65536;
+
+    template <typename Header, typename Read>
+    static std::shared_ptr<const SubmittedCommands> Capture(std::span<const Header> entries,
+                                                           Read&& read) {
+        if (entries.empty() || entries.size() > MaxEntries) return {};
+        const auto metadata_bytes = (entries.size() + 1) * sizeof(std::uint32_t);
+        const auto max_words = (MaxSnapshotBytes - metadata_bytes) / sizeof(Word);
+        std::size_t count{};
+        for (const auto& entry : entries) {
+            const auto words = static_cast<std::size_t>(entry.size);
+            if (words > max_words - count) return {};
+            count += words;
+        }
+        if (!count) return {};
+        const auto bytes = count * sizeof(Word) + metadata_bytes;
+        try {
+            auto snapshot = std::make_shared<SubmittedCommands>();
+            auto lease = std::make_shared<Lease>();
+            lease->used = Budget();
+            auto used = lease->used->load(std::memory_order_relaxed);
+            do {
+                if (used > BudgetBytes - bytes) return {};
+            } while (!lease->used->compare_exchange_weak(used, used + bytes,
+                                                        std::memory_order_acq_rel));
+            lease->bytes = bytes;
+            snapshot->lease = std::move(lease);
+            snapshot->words.resize(count);
+            snapshot->offsets.resize(entries.size() + 1);
+            std::size_t offset{};
+            for (std::size_t i = 0; i < entries.size(); ++i) {
+                snapshot->offsets[i] = static_cast<std::uint32_t>(offset);
+                const auto size = static_cast<std::size_t>(entries[i].size);
+                if (size) read(entries[i].addr, std::span<Word>{snapshot->words}.subspan(offset, size));
+                offset += size;
+            }
+            snapshot->offsets.back() = static_cast<std::uint32_t>(offset);
+            if (eden_command_snapshot_captured) eden_command_snapshot_captured(count * sizeof(Word));
+            return snapshot;
+        } catch (const std::bad_alloc&) {
+            return {}; // Existing live-read path; every reservation unwinds with its payload.
+        }
+    }
+
+    std::optional<std::span<const Word>> Entry(std::size_t index, std::size_t size) const {
+        if (offsets.empty() || index >= offsets.size() - 1) return {};
+        const auto first = offsets[index], last = offsets[index + 1];
+        if (first > last || last > words.size() || last - first != size) return {};
+        return std::span<const Word>{words}.subspan(first, size);
+    }
+    static std::size_t UsedBytes() { return Budget()->load(std::memory_order_acquire); }
+
+private:
+    struct Lease {
+        std::shared_ptr<std::atomic<std::size_t>> used;
+        std::size_t bytes{};
+        ~Lease() { if (bytes) used->fetch_sub(bytes, std::memory_order_acq_rel); }
+    };
+    static std::shared_ptr<std::atomic<std::size_t>> Budget() {
+        static auto used = std::make_shared<std::atomic<std::size_t>>(0);
+        return used;
+    }
+    // Copies of a CommandList share this immutable payload and its one reservation.
+    std::shared_ptr<Lease> lease;
+    std::vector<Word> words;
+    std::vector<std::uint32_t> offsets;
+};
+} // namespace VideoCommon
