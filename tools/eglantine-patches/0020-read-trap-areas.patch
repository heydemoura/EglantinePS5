+    /// Whether [page_begin, page_end) may hold an armed page, without the caller's lock: a count of
+    /// armed pages per 2 MiB area (hashed). False only when none is armed there. A read that skips
+    /// its disarm on that answer leaves at most a trap armed a moment ago, which only traps again.
+    bool MayHold(u64 page_begin, u64 page_end) const {
+        if (Empty()) {
+            return false;
+        }
+        const u64 first = page_begin >> AreaPageBits, last = (page_end - 1) >> AreaPageBits;
+        if (last - first >= 8) {
+            return true;
+        }
+        for (u64 area = first; area <= last; ++area) {
+            if (areas[area % areas.size()].load(std::memory_order_acquire) != 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
