+        if (invalidated) {
+            std::ranges::fill(read_descriptors, 0);
+            invalidated = false;
         }
+        auto& bits = read_descriptors[index / 64];
+        const u64 mask = 1ULL << (index % 64);
+        result.second = (bits & mask) == 0 || result.first != descriptors[index];
+        bits |= mask;
         if (result.second) {
             descriptors[index] = result.first;
