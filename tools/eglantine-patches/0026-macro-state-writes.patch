Register writes a macro makes take a short path. (ProsperoEden eglantine-a42b4d4-ps5.d 0008
macro-state-writes.)

MacroEngine::Execute's emit goes through Maxwell3D::MacroWrite: a state register (not in
execution_mask) takes a short path with CallMethod's effect (shadow RAM, the same-value skip,
dirty flags), without CallMethod's per-write bookkeeping (recent-write ring, macro and split
checks, profile counters). Anything else, and every write while the profile, the method trace
(EDEN_NX2_3D_METHODS) or EglantinePS5's macro register dump is on, or with the split's front
macros, still takes CallMethod.

diff --git a/src/video_core/engines/maxwell_3d.cpp b/src/video_core/engines/maxwell_3d.cpp
index a684572..b860fe2 100644
--- a/src/video_core/engines/maxwell_3d.cpp
+++ b/src/video_core/engines/maxwell_3d.cpp
@@ -457,6 +457,22 @@ void Maxwell3D::TraceFirstMethodWrite(u32 method, u32 argument) {
     }
 }
 
+void Maxwell3D::MacroWrite(Core::System& system, u32 method, u32 argument) {
+    bool bookkeeping = g_trace_first_method_writes || VideoCommon::Nx2Profile::Enabled();
+#ifdef ARCHITECTURE_x86_64
+    bookkeeping = bookkeeping || TuringMacroJit::RtDump::RecordingConfigured();
+#endif
+    if (method < MacroRegistersStart && !execution_mask[method] && !front_macros && !bookkeeping)
+        [[likely]] {
+        const u32 value = ProcessShadowRam(method, argument);
+        if (!SkipSameValueWrites() || regs.reg_array[method] != value) {
+            ProcessDirtyRegisters(method, value);
+        }
+        return;
+    }
+    CallMethod(system, method, argument, true);
+}
+
 void Maxwell3D::CallMethod(Core::System& system, u32 method, u32 method_argument, bool is_last_call) {
     // It is an error to write to a register other than the current macro's ARG register before
     // it has finished execution.
