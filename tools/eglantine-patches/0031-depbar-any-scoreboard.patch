diff --git a/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h b/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
index a2215d717f..04d558eeba 100644
--- a/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
+++ b/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
@@ -1790,8 +1790,11 @@ case 0x311: { // F2I.FTZ.U64.TRUNC, per nvdisasm: Maxwell's F2I gives 32 bits, s
                  (u64{swizzle} << 50) | (u64{array ? 8U : volume ? 7U : dimension == 0 ? 0U : 2U} << 53));
             break;
         }
-        case 0x91a: // DEPBAR.LE SB5, 1: scoreboard wait, represented by IR data dependencies.
-            if (insn.words[0] != 0x791a || (insn.words[1] & ~0xfc0U) != 0xd000 || insn.words[2]) {
+        case 0x91a: // DEPBAR.LE SBn, count, {list}: scoreboard wait, represented by IR data dependencies.
+            // Any scoreboard (bits 44-46), count (38-43) and wait list (32-37) is the same no-op
+            // here: every lowered load completes before the next instruction. (This core has no
+            // LDGSTS lowering, so SB0 waits need no MEMBAR for asynchronous copies.)
+            if (insn.words[0] != 0x791a || (insn.words[1] & ~0x7fffU) != 0x8000 || insn.words[2]) {
                 return fail(index, "native dependency barrier mode");
             }
             break;
diff --git a/src/tests/video_core/ampere_pokopia_compute.cpp b/src/tests/video_core/ampere_pokopia_compute.cpp
index 2a1ecc5a8a..7db28e15d7 100644
--- a/src/tests/video_core/ampere_pokopia_compute.cpp
+++ b/src/tests/video_core/ampere_pokopia_compute.cpp
@@ -73,4 +73,23 @@ TEST_CASE("Ampere LEA with a constant base and no carry out lowers to ISCADD",
     negated.words[1] |= 1U << 31;
     REQUIRE_FALSE(static_cast<bool>(LowerToMaxwell(std::array{negated, Exit})));
 }
+
+TEST_CASE("Ampere DEPBAR.LE on any scoreboard and wait list is a no-op", "[video_core][ampere]") {
+    // DEPBAR.LE SB5, 0x1 and DEPBAR.LE SB0, 0x0, {3,2,1} (op 91a 0000791a 0000800e 00000000
+    // 000fce00, Pokemon Pokopia's compute shaders).
+    for (const u32 word : {0x0000d040U, 0x0000800eU, 0x00008000U, 0x00008fffU, 0x0000ffffU}) {
+        const Instruction wait{{0x0000791a, word, 0, 0x000fce00}};
+        const auto lowered = LowerToMaxwell(std::array{wait, Exit});
+        INFO(lowered.error);
+        REQUIRE(static_cast<bool>(lowered));
+        REQUIRE(lowered.instructions.size() == 1);
+        REQUIRE(lowered.instructions.back() == 0xe30000000007000fULL);
+    }
+    for (const Instruction invalid : {Instruction{{0x0000791a, 0x0000400e, 0, 0}},
+                                      Instruction{{0x0000791a, 0x0001800e, 0, 0}},
+                                      Instruction{{0x0000791a, 0x0000800e, 1, 0}},
+                                      Instruction{{0x0000191a, 0x0000800e, 0, 0}}}) {
+        REQUIRE_FALSE(static_cast<bool>(LowerToMaxwell(std::array{invalid, Exit})));
+    }
+}
 } // namespace
