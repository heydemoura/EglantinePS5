+// Fast draw delta draws replay the image descriptors the resolve that captured their views pushed
+// (Lichii #949). EDEN_NX2_DELTA_DESCRIPTORS=0 turns it off; EDEN_NX2_DELTA_DESCRIPTORS_VERIFY=1
+// resolves them as before and compares with the kept ones.
+// Both are read at the first draw: the PS5 app sets its environment from env.txt in main, after
+// static initializers ran.
+bool DeltaDescriptorsOn() {
+    static const bool on = [] {
+        const char* const value = std::getenv("EDEN_NX2_DELTA_DESCRIPTORS");
+        return value == nullptr || value[0] != '0';
+    }();
+    return on;
+}
+bool DeltaDescriptorsVerify() {
+    static const bool verify = [] {
+        const char* const value = std::getenv("EDEN_NX2_DELTA_DESCRIPTORS_VERIFY");
+        return DeltaDescriptorsOn() && value != nullptr && value[0] == '1';
+    }();
+    return verify;
+}
+
+// Delta draws on the drawing thread, logged every 10 s with EDEN_NX2_GPU_PROFILE or the verify
+// env.
+struct DeltaDescriptorStats {
+    u64 replayed{};
+    u64 pushed{};
+    u64 verified{};
+    u64 mismatches{};
+    std::chrono::steady_clock::time_point next_report{};
+} delta_descriptor_stats;
+
+void ReportDeltaDescriptors() {
+    DeltaDescriptorStats& stats = delta_descriptor_stats;
+    if (((stats.replayed + stats.pushed) & 1023) != 0 ||
+        (!VideoCommon::Nx2Profile::Enabled() && !DeltaDescriptorsVerify())) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now < stats.next_report) {
+        return;
+    }
+    if (stats.next_report != std::chrono::steady_clock::time_point{}) {
+        LOG_INFO(Render_Vulkan,
+                 "Delta descriptors in 10 s: {} replayed, {} pushed, {} verified, {} verify "
+                 "mismatches{}",
+                 stats.replayed, stats.pushed, stats.verified, stats.mismatches,
+                 DeltaDescriptorsOn() ? "" : " (off: EDEN_NX2_DELTA_DESCRIPTORS=0)");
+    }
+    stats = {.next_report = now + std::chrono::seconds{10}};
+}
