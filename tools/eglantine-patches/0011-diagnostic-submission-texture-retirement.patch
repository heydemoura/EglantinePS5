diff --git a/src/video_core/texture_cache/completion_destruction.h b/src/video_core/texture_cache/completion_destruction.h
new file mode 100644
index 0000000000..75b7b8be3e
--- /dev/null
+++ b/src/video_core/texture_cache/completion_destruction.h
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <utility>
+#include <vector>
+
+namespace VideoCommon {
+// A submission tick also covers work still queued on the Vulkan recording worker.
+// Only the owner appends/collects. No GPU wait or submission is introduced here.
+template <class T>
+class CompletionDestructionQueue {
+public:
+    void Push(std::uint64_t tick, T&& object) {
+        if (batches.empty() || batches.back().tick != tick) {
+            batches.emplace_back(tick);
+        }
+        batches.back().objects.push_back(std::move(object));
+    }
+
+    template <class IsComplete>
+    void Collect(IsComplete&& is_complete) {
+        while (!batches.empty() && is_complete(batches.front().tick)) {
+            batches.pop_front();
+        }
+    }
+
+    template <class Visitor>
+    void ForEach(Visitor&& visitor) const {
+        for (const auto& batch : batches) {
+            for (const auto& object : batch.objects) visitor(object);
+        }
+    }
+
+private:
+    struct Batch {
+        explicit Batch(std::uint64_t tick_) : tick{tick_} {}
+        std::uint64_t tick;
+        std::vector<T> objects;
+    };
+    std::deque<Batch> batches;
+};
+
+// Per-boot diagnostic. The frame-based policy remains the default.
+inline bool CompletionDestructionEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_PS5_COMPLETION_RETIREMENT");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+template <class Runtime, class Ring, class T>
+void RetireTextureObject(Runtime& runtime, Ring& ring,
+                         CompletionDestructionQueue<T>& completed, T&& object) {
+    if constexpr (requires { runtime.RetirementTick(); }) {
+        if (CompletionDestructionEnabled()) {
+            completed.Push(runtime.RetirementTick(), std::move(object));
+            return;
+        }
+    }
+    ring.Push(std::move(object));
+}
+} // namespace VideoCommon
